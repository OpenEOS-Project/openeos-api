# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1
APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=openeos
DATABASE_PASSWORD=openeos_dev_password
DATABASE_NAME=openeos
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=true
DATABASE_MIGRATIONS_RUN=false
# Connection pool (optional). Defaults: 10 connections, idle connections
# stay open for 10 min, acquiring a connection fails after 5 s.
# DATABASE_POOL_MAX=10
# DATABASE_POOL_IDLE_TIMEOUT_MS=600000
# DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRATION=30m
JWT_REFRESH_TOKEN_EXPIRATION=7d

# CORS
# In production, must also include the marketing site domain(s) so
# /public/contact can be called from there, e.g.
# https://openeos.de,https://www.openeos.de
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Reverse proxy: which proxies may set X-Forwarded-For (client IP for
# sessions, audit log and rate limiting). Unset = proxies on loopback,
# link-local and private networks (e.g. Traefik/nginx in a Docker network).
# Alternatives: a hop count (1 = exactly one proxy in front of the API),
# a comma-separated list of proxy IPs/CIDRs, or "false" when the API is
# reachable directly without a proxy. "true" is not accepted.
#TRUST_PROXY=loopback, linklocal, uniquelocal

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=300

# SumUp (Mock for development)
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
SUMUP_WEBHOOK_SECRET=

# File Storage (Mock for development)
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
# Upload-Verzeichnis (Bilder, Speisekarten-Import). Im Container /app/uploads;
# bei einem Bind-Mount muss das Host-Verzeichnis dem Container-Nutzer gehoeren:
# `chown -R 1001 <verzeichnis>` — sonst 503 UPLOAD_DIR_NOT_WRITABLE.
UPLOAD_DIR=./uploads

# Email (Mock for development)
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@openeos.de
# Absendername — auf Testsystemen abweichend setzen, damit Mails von dort
# erkennbar sind (z. B. "OpenEOS Staging").
EMAIL_FROM_NAME=OpenEOS
# Recipient for "new registration" admin notifications. Falls back to
# ADMIN_EMAIL below if unset; leave both empty to disable the notification.
ADMIN_NOTIFY_EMAIL=

# Two-Factor Authentication (2FA)
# REQUIRED in production - encryption key for TOTP secrets (min 32 chars)
TWO_FACTOR_ENCRYPTION_KEY=
# Issuer name shown in authenticator apps
TWO_FACTOR_ISSUER=OpenEOS
# Schlüssel für die Zugangsdaten der Zahlungsanbieter (SumUp, PayPal) in den
# Organisationseinstellungen (AES-256-GCM). Leer: Rückfall auf
# TWO_FACTOR_ENCRYPTION_KEY. Sichern — ohne ihn müssen die Vereine ihre
# Zugangsdaten neu eingeben. Nach dem ersten Setzen nicht mehr ändern.
INTEGRATION_ENCRYPTION_KEY=
# Email OTP expiry in minutes
EMAIL_OTP_EXPIRY_MINUTES=5
# Trusted device cookie expiry in days
TRUSTED_DEVICE_EXPIRY_DAYS=30

# Stripe (Payment Processing) — Webhook-Ereignisse siehe Abschnitt Abrechnung
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Sentry (Error Tracking & Performance Monitoring)
SENTRY_DSN=
# Optional: Override release version (defaults to package.json version)
# SENTRY_RELEASE=

# Initial Admin (for seeding)
# Also used as the fallback recipient for registration notifications
# if ADMIN_NOTIFY_EMAIL above isn't set.
ADMIN_EMAIL=admin@openeos.local
# CHANGE_ME — set a real password before seeding; this file is an example,
# not a default, and "Admin123!" is exactly the kind of value that gets
# copy-pasted straight into a real .env.
ADMIN_PASSWORD=CHANGE_ME

# Event-Abrechnung (Pay-per-Event-Freischaltung)
# Preis pro Veranstaltungstag in Euro. Eine mehrtägige Veranstaltung kostet
# entsprechend ein Vielfaches. Hinweis § 19 UStG: Kleinunternehmerregelung —
# der Preis ist ein Endpreis, es wird keine Umsatzsteuer ausgewiesen.
EVENT_PRICE_EUR=25
# Tageswechsel für die Abrechnung (Stunde, Ortszeit der Organisation, 1–23).
# Ein Veranstaltungstag läuft von 6 bis 6 Uhr: Sa 20 Uhr bis So 2 Uhr ist ein
# Tag, Fr 17 Uhr bis So 18 Uhr sind drei. Ein Ende bis einschließlich 6:00
# zählt noch zum Vortag. Bereits bezahlte Veranstaltungen bleiben unberührt.
BUSINESS_DAY_START_HOUR=6
# Nachlass auf die erste abgerechnete Veranstaltung einer Organisation.
# Stapelt sich nicht mit einem manuell hinterlegten Org-Rabatt — es gilt der höhere.
FIRST_EVENT_DISCOUNT_PERCENT=20
# Cloud-TSE-Zuschlag je Veranstaltung (nicht je Tag) in Euro, nur für
# Freischaltungen in Deutschland mit Cloud-TSE („Alle Funktionen“ oder
# Bestand mit „Ja“ im Bezahldialog). 0 = derzeit inklusive: keine eigene
# Position, kein Hinweis. Größer 0: eine Position „Cloud-TSE“ in Stripe-
# Checkout, Rechnung und Preisvorschau, ohne Nachlass; bei kostenloser
# Stornierung wird sie mit erstattet.
TSE_EVENT_SURCHARGE_EUR=0
# Stripe wickelt die Freischaltung ab. Ohne Secret Key bleibt nur der Kauf auf
# Rechnung; das Webhook-Secret stammt aus dem Endpunkt im Stripe-Dashboard
# (<API_URL>/api/public/stripe/webhook) und ist Pflicht, sobald bezahlt wird —
# ohne Signaturprüfung könnte jeder eine Freischaltung vortäuschen.
# Am Endpunkt diese Ereignisse abonnieren (STRIPE_WEBHOOK_EVENTS im Code):
#   checkout.session.completed, checkout.session.async_payment_succeeded,
#   checkout.session.async_payment_failed, checkout.session.expired,
#   refund.updated, refund.failed, charge.dispute.created, charge.dispute.closed,
#   invoice.finalized, invoice.sent, invoice.paid, invoice.payment_failed,
#   invoice.voided, invoice.marked_uncollectible,
#   credit_note.created, credit_note.voided
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Kauf auf Rechnung: Stripe Invoicing stellt die Rechnung aus und verschickt
# sie (PDF, Zahlungslink, Bankverbindung, Erinnerungen). Zahlungsziel in
# Tagen; eine Organisation kann im Adminbereich ein eigenes bekommen.
# Ohne STRIPE_SECRET_KEY bleibt es bei der Rechnung von Hand.
STRIPE_INVOICE_DAYS_UNTIL_DUE=14
# Maximale Anzahl Bestellungen im Test-Modus, bevor die Veranstaltung
# freigeschaltet werden muss.
TEST_EVENT_MAX_ORDERS=25
# Phasen einer freigeschalteten Veranstaltung (Geplant – Aktiv – Beendet).
# Echte Verkaeufe beginnen EVENT_EARLY_START_HOURS vor dem ersten
# Geschaeftstag (Fest am 16. → ab 15. um 18 Uhr) und enden
# EVENT_GRACE_HOURS nach dem letzten (Kulanz fuer spaete Deckel, hoechstens
# 13). Vorher bucht die Kasse Testbestellungen (hoechstens
# EVENT_PLANNED_TEST_MAX_ORDERS), danach keine neuen Bestellungen mehr.
# Je Veranstaltung laesst sich der Vorlauf bis EVENT_EARLY_START_MAX_HOURS
# einstellen. EVENT_DATE_PHASES=false: nur der Status zaehlt (wie frueher).
EVENT_DATE_PHASES=true
EVENT_EARLY_START_HOURS=12
EVENT_EARLY_START_MAX_HOURS=24
EVENT_GRACE_HOURS=6
EVENT_PLANNED_TEST_MAX_ORDERS=200
# Optional: API-Key für die Firmensuche (openregister.de) im Kauf-auf-Rechnung-
# Formular. Leer lassen, um die Funktion zu deaktivieren.
OPENREGISTER_API_KEY=

# Support-Chat und Website-Formulare (Kontakt, Demo, Rückmeldung)
# Adresse, an die neue Support-Nachrichten und Kontaktanfragen per E-Mail
# gemeldet werden (Versand über den oben konfigurierten Mailserver).
# Leer: es gilt die allgemeine Admin-Adresse (Super-Admin-Einstellungen,
# sonst ADMIN_NOTIFY_EMAIL / ADMIN_EMAIL). Ist gar keine Adresse gesetzt,
# geht keine Mail hinaus — die Anfragen liegen trotzdem in der Datenbank
# und sind im Super-Admin-Bereich unter Support bzw. Rückmeldungen einsehbar.
SUPPORT_NOTIFY_EMAIL=

# ─── Assistent (KI-Funktionen, opt-in je Organisation) ─────────────────
# Anbieter: 'none' (Standard, alle Assistent-Endpunkte antworten 404
# AI_DISABLED), 'anthropic' (Claude, Messages API) oder 'openai'
# (Chat Completions gegen eine OpenAI-kompatible API — OpenAI selbst oder
# z. B. IONOS AI Model Hub mit eigener OPENAI_BASE_URL). PDFs gehen bei
# 'openai' als Seitenbilder (pdftoppm aus poppler-utils, im Docker-Image).
#
# Empfehlung IONOS AI Model Hub (Rechenzentrum Berlin; so laeuft auch das
# gehostete Angebot app.openeos.de):
#   AI_PROVIDER=openai
#   OPENAI_API_KEY=<Token, nur für den AI Model Hub>
#   OPENAI_BASE_URL=https://openai.inference.de-txl.ionos.com/v1
#   AI_MODEL_EXTRACT=Qwen/Qwen3.8-27B
#   AI_MODEL_CLASSIFY=Qwen/Qwen3.8-27B
#   AI_REASONING_EFFORT_EXTRACT=medium
#   AI_REASONING_EFFORT_CLASSIFY=none
#   AI_MAX_IMAGES_PER_REQUEST=4
AI_PROVIDER=none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Leer: https://api.openai.com/v1
OPENAI_BASE_URL=
# Modell-IDs. Leer: Standard je Anbieter — anthropic: claude-sonnet-5-5 /
# claude-haiku-4-5-20251001, openai: gpt-5 / gpt-5-mini.
AI_MODEL_EXTRACT=
AI_MODEL_CLASSIFY=
# Kontingente je Organisation und Kalendertag (Europe/Berlin). Self-Hoster
# mit eigenem Schlüssel setzen sie so hoch, wie sie möchten.
AI_MENU_IMPORTS_PER_DAY=5
AI_MENU_PAGES_PER_IMPORT=6
AI_CLASSIFY_PER_DAY=500
# Maximale Dateigröße je hochgeladener Speisekarte (Bild/PDF) in MB
AI_MAX_UPLOAD_MB=10
# Nur 'openai': reasoning_effort je Zweck (none|minimal|low|medium|high|xhigh).
# Leer: Parameter wird nicht gesendet. Reasoning-Modelle brauchen für die
# Klassifikation meist 'none', sonst läuft das Token-Limit voll.
AI_REASONING_EFFORT_EXTRACT=
AI_REASONING_EFFORT_CLASSIFY=
# Höchstens so viele Bilder je Modellaufruf (leer/0: unbegrenzt). Längere
# Karten liest der Import in mehreren Aufrufen. IONOS AI Model Hub: 4.
AI_MAX_IMAGES_PER_REQUEST=

# ─── Cloud-TSE (Swissbit Cloud-TSE 2, Integration „tse“) ───────────────
# README „Cloud-TSE“. 'none' (Standard): keine TSE, die Integration lässt
# sich nicht einschalten. 'swissbit': TSE je Organisation in Deutschland.
TSE_PROVIDER=none
# Nur gehostet: 'true' kündigt die Cloud-TSE ohne eingerichteten Provider
# als „Bald verfügbar“ an (statt „nicht eingerichtet“). Eigene
# Installationen (DEPLOYMENT_MODE=selfhosted) ignorieren den Wert.
TSE_COMING_SOON=false
# 'monthly' (Standard): die TSE läuft für den Monat der Veranstaltung und
# wird am letzten Tag um 20:00 (Berlin) nach Abschlussexport abgemeldet;
# läuft dann gerade ein bezahltes Fest, einen Monat später. Die nächste
# Veranstaltung bekommt eine neue TSE. ('per_event' ist der alte Name.)
# 'persistent': eine TSE bleibt aktiv, bis sie deaktiviert wird.
TSE_LIFECYCLE=monthly
# Leer: https://web-tse.de (Produktion). Entwicklung: https://dev.web-tse.de
SWISSBIT_BASE_URL=
# Vendor-Zugang von Swissbit (Billing API: Credit Tokens, Nutzungsbericht)
SWISSBIT_VENDOR_CLIENT=
SWISSBIT_VENDOR_SECRET=
# Credit Token der Plattform (legt TSEs an, Kosten gehen an uns). Einmal
# anlegen mit `pnpm tse:create-credit-token` — das Secret gibt es nur einmal.
SWISSBIT_CREDIT_CLIENT_ID=
SWISSBIT_CREDIT_CLIENT_SECRET=
# Produkttyp aus den `validProductTypes` des Credit Tokens, z. B.
# 850007 (M, 20.000 Signaturen/Monat, danach langsamer) oder 850008 (L, unbegrenzt)
SWISSBIT_PRODUCT_TYPE=
# Schlüssel für das Access Token je TSE (AES-256-GCM). Leer: Rückfall auf
# TWO_FACTOR_ENCRYPTION_KEY. Unbedingt sichern — ohne ihn ist die TSE
# nicht mehr bedienbar.
TSE_ENCRYPTION_KEY=
# TAR-Exporte (nicht öffentlich). Leer: UPLOAD_DIR/tse-exports
TSE_EXPORT_DIR=
# Zeitlimit je Transaktionsaufruf, Gesamtbudget je Vorgang (start+finish)
# und für Verwaltungsaufrufe in ms. Danach: Beleg mit „TSE ausgefallen“.
TSE_TX_TIMEOUT_MS=5000
TSE_SIGN_BUDGET_MS=8000
TSE_ADMIN_TIMEOUT_MS=15000

# Zeitzone für stundenbasierte Auswertungen (Default: Europe/Berlin)
REPORT_TIMEZONE=Europe/Berlin

# ─── Missbrauchsschranken ───────────────────────────────────────────────
# Wie viele Organisationen ein Benutzer anlegen bzw. in wie vielen er
# Mitglied sein darf, und wie viele Mitglieder eine Organisation haben darf
# (aktive Mitglieder plus offene Einladungen). 0 = unbegrenzt. Super-Admins
# sind ausgenommen und können im Adminbereich je Benutzer bzw. Organisation
# einen eigenen Wert hinterlegen. Helfer (Schichtanmeldungen, Anmeldelinks)
# sind keine Mitglieder und zählen nicht.
ORGANIZATIONS_PER_USER_LIMIT=5
MEMBERS_PER_ORGANIZATION_LIMIT=10

# ─── Betriebsart ────────────────────────────────────────────────────────
# 'saas'       — gehostet, mehrere Organisationen, kostenpflichtige
#                Freischaltung je Veranstaltung (Standard).
# 'selfhosted' — eigenstaendige Installation: kostenlos, genau eine
#                Organisation, kein Stripe, keine Rechnungen, kein
#                Testmodus-Limit. Die Ersteinrichtung laeuft dann immer im
#                Einzelbetrieb und legt einen Administrator an, der die
#                Installation vollstaendig verwalten kann.
#                Selbstregistrierung ist abgeschaltet — weitere Benutzer
#                legt die Mitgliederverwaltung mit Startpasswort an.
DEPLOYMENT_MODE=saas

# ─── Plattform-Links auf Shop und Helferseiten ───────────────────────────
# Shop und Helferseiten zeigen Impressum und Datenschutz des Vereins (aus den
# Organisationseinstellungen) und darunter klein "Bereitgestellt mit
# OpenEOS" mit den Links des Plattformbetreibers. Nicht gesetzt: im Modus
# saas /impressum und /datenschutz unter LEGAL_SITE_URL (siehe unten, also
# openeos.de bzw. auf Staging staging.openeos.de), im Modus selfhosted keine
# Links (dann zaehlen nur die Angaben des Vereins). Leer gesetzt: Link
# ausblenden. Die Shop-Startseite holt sie ueber GET /legal/versions.
# PLATFORM_IMPRINT_URL=https://openeos.de/impressum
# PLATFORM_PRIVACY_URL=https://openeos.de/datenschutz

# ─── Rechtstexte von LUXCODE (AGB, AVV, Datenschutz, Impressum) ─────────
# Die Texte liegen auf der Website (openeos-landing), jede Fassung unter
# /<dokument>/<JJJJ-MM-TT> und als PDF unter /rechtstexte/<dokument>-<datum>.pdf.
# LEGAL_SITE_URL: Basis der Website; nicht gesetzt = aus APP_URL abgeleitet
# (app.openeos.de → https://openeos.de), sonst https://openeos.de.
# LEGAL_*_VERSION: Datum der „Stand“-Zeile der aktuellen Fassung. Steigt die
# AGB- oder AVV-Fassung, muessen alle Admins sie beim naechsten Login neu
# annehmen. Im Modus selfhosted gelten diese Texte nicht.
# LEGAL_SITE_URL=https://openeos.de
# LEGAL_AGB_VERSION=2026-11-04
# LEGAL_AVV_VERSION=2026-11-04
# LEGAL_PRIVACY_VERSION=2026-11-04
# LEGAL_IMPRINT_VERSION=2026-11-04

# ─── Betrieb mit mehreren Instanzen / Deploys ohne Ausfallzeit ──────────
# DATABASE_MIGRATIONS_RUN (oben): Bei mehreren Instanzen false und vor
# jedem Rollout einmal `pnpm migration:run:prod` bzw. den Compose-Dienst
# `migrate` laufen lassen — siehe README.
# Herunterfahren (SIGTERM): so lange duerfen offene Anfragen noch laufen.
#SHUTDOWN_TIMEOUT_MS=20000
# Optional: so lange meldet die Instanz nach SIGTERM schon "nicht bereit"
# (/api/health/ready = 503), bedient aber noch — fuer Proxys, die erst die
# Readiness-Pruefung bemerken muessen. Mit docker-rollout nicht noetig.
#SHUTDOWN_DRAIN_DELAY_MS=0
# Token fuer GET /api/internal/deploy-guard (mind. 32 Zeichen, z. B.
# `openssl rand -hex 32`). Leer: Endpunkt antwortet 404.
DEPLOY_GUARD_TOKEN=

# Herstellerangaben fuer die Herstellerbescheinigung im Betriebsmodus
# „Nur Bestellen“ (PDF fuer die Verfahrensdokumentation der Vereine).
# Wie das Impressum der Website. Adresszeilen mit „|“ trennen.
OPERATOR_NAME=LUXCODE by Lukas Lukic-Spitznagel
OPERATOR_ADDRESS=
OPERATOR_EMAIL=hello@openeos.de

# Notfall-Support am Veranstaltungstag (AGB Ziffer 18.2): Rufnummer fuer
# kritische Stoerungen. Sehen nur Mitglieder (und Kassen) einer
# Organisation mit gebuchter, noch nicht beendeter Veranstaltung — im
# Support-Bereich, im Dashboard, bei den Veranstaltungen, im Kassenmenue
# und in der Buchungsbestaetigung. Leer (Standard): nirgends angezeigt.
OPERATOR_EMERGENCY_PHONE=

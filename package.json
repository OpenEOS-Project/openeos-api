{
  "name": "openeos-api",
  "version": "0.0.1",
  "description": "",
  "author": "Lukas Lukic-Spitznagel",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "dev": "nest start --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate": "pnpm typeorm migration:generate -d src/config/data-source.ts",
    "migration:run": "pnpm typeorm migration:run -d src/config/data-source.ts",
    "migration:revert": "pnpm typeorm migration:revert -d src/config/data-source.ts",
    "migration:run:prod": "node node_modules/typeorm/cli.js migration:run -d dist/src/config/data-source.js",
    "seed": "ts-node -r tsconfig-paths/register src/database/seeds/seed.ts",
    "docs:generate": "ts-node -r tsconfig-paths/register scripts/generate-openapi.ts",
    "docs:check": "ts-node -r tsconfig-paths/register scripts/generate-openapi.ts --check",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "tse:create-credit-token": "ts-node -r tsconfig-paths/register scripts/tse-create-credit-token.ts",
    "dsfinvk:validate": "ts-node -r tsconfig-paths/register --transpile-only scripts/dsfinvk-validate.ts",
    "icons:sync": "ts-node -r tsconfig-paths/register scripts/sync-pos-icon-index.ts && prettier --write src/modules/assistant/icons/pos-icon-index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@keyv/redis": "5.1.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.2.9",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.9",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.9",
    "@nestjs/platform-socket.io": "^11.2.9",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/websockets": "^11.2.9",
    "@sentry/nestjs": "^10.78.0",
    "@sentry/profiling-node": "^10.78.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@sumup/sdk": "^0.0.12",
    "@types/pdfkit": "^0.17.7",
    "bcrypt": "^6.0.0",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "joi": "^18.3.2",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0",
    "openai": "^7.55.0",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "redis": "^5.12.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "stripe": "^20.4.1",
    "typeorm": "^0.3.31",
    "uuid": "^13.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.9",
    "@openeos/pos-icons": "0.4.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^7.0.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^11.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "yaml": "^2.8.1"
  },
  "//pnpm.overrides": "typeorm 0.3.x still asks for glob ^10; glob 14 keeps the sync API typeorm uses. Remove once typeorm accepts a newer glob.",
  "pnpm": {
    "overrides": {
      "typeorm>glob": "^14.0.2"
    }
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!uuid/)"
    ],
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.spec.ts",
      "!**/*.d.ts",
      "!main.ts",
      "!**/*.module.ts",
      "!database/migrations/**",
      "!database/seeds/**"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "coverageReporters": [
      "lcov",
      "text-summary"
    ]
  }
}
